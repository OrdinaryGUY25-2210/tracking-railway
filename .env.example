# Railway otomatis mengisi ini kalau kamu tambah plugin "PostgreSQL"
# di project Railway yang sama dengan service backend ini.
DATABASE_URL=postgresql://user:password@host:port/dbname

# Ganti dengan string acak panjang (mis. hasil: openssl rand -hex 32)
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=7d

# Origin frontend (Vercel) yang boleh akses API ini — untuk CORS.
# Boleh lebih dari satu, dipisah koma.
FRONTEND_ORIGIN=https://nama-app-kamu.vercel.app,http://localhost:5173

PORT=8080

# --- Dipakai fitur AI / interview assistant (opsional, isi kalau dipakai) ---
ANTHROPIC_API_KEY=
ASSEMBLYAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# --- Dipakai fitur kirim email lamaran & daily digest (opsional) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
DIGEST_TO=
